# All NEXT_PUBLIC_* are inlined into the bundle at build time.
#
# Production: only the base path. Leave the URLs empty and the app calls the
# domain it was served from (/api/wahub and wss://<host>/wsWahub/), so the same
# image works on any domain.
NEXT_PUBLIC_BASE_PATH=

# Local development: point at the backend when it runs on another port.
#   NEXT_PUBLIC_API_URL=http://localhost:7001/api/wahub
#   NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_APP_URL=

# Serve the bots screen from local mocks instead of the API.
NEXT_PUBLIC_USE_MOCKS=
