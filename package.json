{
  "name": "wahub-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "prebuild": "rm -rf .next",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "geist": "^1.3.1",
    "next": "^15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.18",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
